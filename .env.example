# ============ docker compose (docker-compose.yml) ============
# copy to .env and fill these in

# the address Caddy serves: a domain for automatic HTTPS, or ":8080" for plain HTTP on a LAN
TUBEHAUS_SITE=tube.example.com
# the same, as browsers open it
TUBEHAUS_URL=https://tube.example.com
TUBEHAUS_DOMAIN=tube.example.com
# for ":8080" without HTTPS:  TUBEHAUS_HTTPS=false  TUBEHAUS_EXTERNAL_PORT=8080
TUBEHAUS_HTTPS=true
TUBEHAUS_EXTERNAL_PORT=443

# secrets - make up your own:  openssl rand -hex 8  (COMPANION_KEY must be exactly 16 characters)
COMPANION_KEY=change-me-16char
INVIDIOUS_HMAC_KEY=change-me-to-something-long
POSTGRES_PASSWORD=change-me

# optional built-in login (recommended before exposing TubeHaus to the internet)
#   TUBEHAUS_AUTH=basic, then a user name and a bcrypt hash from:
#   docker compose run --rm caddy caddy hash-password
#   (in this file every $ in the hash must be written as $$)
TUBEHAUS_AUTH=none
TUBEHAUS_USER=
TUBEHAUS_PASSWORD_HASH=

# translated subtitles target / live caption language
TUBEHAUS_SUB_LANG=en
TUBEHAUS_CAPTION_LANG=auto


# ============ running the server without docker (deploy/tubehaus.service) ============
# HT_BIND=127.0.0.1
# HT_PORT=3010
# HT_STATE=./state                          # library and subtitle cache
# HT_INVIDIOUS=http://127.0.0.1:3000
# HT_COMPANION=http://127.0.0.1:8282
# HT_PUBLIC_URL=https://tube.example.com    # where browsers open TubeHaus
# HT_YT_PROXY=127.0.0.1:40000               # Cloudflare WARP in proxy mode ("" = direct)
# HT_WARP_ROTATE=1                          # reconnect WARP when YouTube blocks the address
# HT_YTDLP=yt-dlp                           # + bgutil-ytdlp-pot-provider, for live streams
# HT_WHISPER_BIN=/opt/whisper/build/bin/whisper-cli
# HT_WHISPER_MODEL=/opt/whisper/models/ggml-base-q5_1.bin
# HT_WHISPER_LANG=auto
# HT_SUB_LANG=en
# HT_LIBRETRANSLATE=                        # optional translation fallback
# HT_DOWNLOAD_DIR=/var/tmp/tubehaus-dl      # offline save (needs ffmpeg, ~10 GB free)
